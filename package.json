{
  "name": "agentflow",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "plugins:sync": "node scripts/plugin-manifests.mjs --write",
    "plugins:check": "node scripts/plugin-manifests.mjs --check",
    "skills:generate": "node scripts/generate-skills.mjs",
    "predev": "npm run skills:generate",
    "dev": "astro dev",
    "prebuild": "npm run skills:generate && npm run plugins:check",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test scripts/*.test.mjs && node --test packages/cli/test/*.test.mjs",
    "cli:test": "node --test packages/cli/test/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "@astrojs/starlight-tailwind": "5.0.0",
    "@lucide/astro": "1.61.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "tailwindcss": "4.3.3"
  }
}
