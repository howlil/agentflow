---
interface Props {
  title: string;
  skill: string;
  description: string;
  href: string;
}

const { title, skill, description, href } = Astro.props;
---

<a
  href={href}
  class="group block rounded-xl border border-slate-200 bg-white p-4 no-underline transition hover:border-slate-300 hover:shadow-sm dark:border-slate-800 dark:bg-slate-950 dark:hover:border-slate-700"
>
  <div class="mb-3 flex items-start justify-between gap-3">
    <h3 class="m-0 text-base font-semibold tracking-tight text-slate-900 dark:text-slate-100">
      {title}
    </h3>
    <span class="shrink-0 rounded-md bg-slate-100 px-2 py-1 font-mono text-xs text-slate-600 dark:bg-slate-900 dark:text-slate-400">
      {skill}
    </span>
  </div>
  <p class="m-0 text-sm leading-6 text-slate-600 dark:text-slate-400">{description}</p>
  <span class="mt-4 inline-flex text-sm font-medium text-blue-600 group-hover:underline dark:text-blue-400">
    Open guide →
  </span>
</a>
