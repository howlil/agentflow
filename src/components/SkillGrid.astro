---
import { getEntry } from 'astro:content';
import SkillCard from './SkillCard.astro';
import skills from '../generated/skills.json';

const cards = await Promise.all(
  skills.map(async (skill) => {
    const guide = await getEntry('docs', `skills/${skill.name}`);
    if (!guide) throw new Error(`Missing human guide for ${skill.name}`);

    return {
      title: guide.data.title,
      skill: skill.name,
      description: guide.data.description ?? skill.description,
      href: `/skills/${skill.name}/`,
    };
  }),
);

const router = cards.find(card => card.skill === 'agentflow');
if (!router) throw new Error('Missing canonical agentflow router');
const specialists = cards.filter(card => card.skill !== 'agentflow');
---

<div class="af-skill-catalog">
  <section aria-label="Routing skill">
    <p class="af-skill-catalog__eyebrow">01 / Start here</p>
    <div class="af-skill-catalog__router">
      <SkillCard {...router} featured />
    </div>
  </section>

  <section aria-label="Specialist skills">
    <div class="af-skill-catalog__group-heading">
      <p class="af-skill-catalog__eyebrow">02 / Specialists</p>
      <span>{specialists.length} focused skills</span>
    </div>
    <div class="skill-grid">
      {specialists.map(skill => <SkillCard {...skill} />)}
    </div>
  </section>
</div>

<style>
  .af-skill-catalog { display: grid; gap: 2rem; }
  .af-skill-catalog__eyebrow {
    margin: 0 0 0.75rem;
    font: 600 0.7rem/1.25 var(--af-font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .af-skill-catalog__group-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.75rem;
  }
  .af-skill-catalog__group-heading .af-skill-catalog__eyebrow { margin: 0; }
  .af-skill-catalog__group-heading span {
    font: 500 0.75rem/1.3 var(--af-font-mono);
    color: var(--sl-color-gray-3);
  }
  .af-skill-catalog__router { display: grid; }
  .skill-grid { margin: 0; }
</style>
