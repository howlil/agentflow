---
import AsciiWaves from './AsciiWaves.astro';
import DispatchConsole from './DispatchConsole.astro';
---

<section class="agentflow-hero" aria-labelledby="agentflow-hero-title">
  <div class="ascii-layer" aria-hidden="true">
    <AsciiWaves
      characters=" .:-=+*#%@"
      color="225,230,242"
      elementSize={14}
      noiseScale={1}
      speed={0.9}
      waveTension={0.5}
      waveTwist={0.1}
      intensity={1}
      hasCursorInteraction={true}
      interactionIntensity={0.55}
    />
  </div>

  <div class="quiet-zone" aria-hidden="true"></div>

  <div class="hero-shell">
    <div class="copy">
      <p class="micro-label">Agentic engineering skills</p>

      <h1 id="agentflow-hero-title">
        <span>Better judgment</span>
        <span>for AI agents.</span>
      </h1>

      <p class="description">
        The right skill for every engineering decision. One router and seven
        specialists help coding agents focus on the reasoning a task needs.
      </p>

      <div class="domains" aria-hidden="true">
        <span>Product</span>
        <span>Architecture</span>
        <span>Interface</span>
        <span>Testing</span>
        <span>Review</span>
      </div>

      <div class="hero-actions">
        <a class="primary-action" href="/start/distribution/">Install Agentflow <span aria-hidden="true">→</span></a>
        <a class="secondary-action" href="/start/choose-a-skill/">Explore skills</a>
      </div>
    </div>

    <div class="console">
      <DispatchConsole />
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap');

  .agentflow-hero {
    --landing-bg: var(--af-ink, #0C0D10);
    --landing-fg: var(--af-ivory, #F6F4EF);
    --landing-body: rgba(247, 246, 242, 0.84);
    position: relative;
    left: 50%;
    width: 100vw;
    min-height: calc(100svh - var(--sl-nav-height, 4rem));
    margin-left: -50vw;
    overflow: hidden;
    background: var(--landing-bg);
    color: var(--landing-fg);
    isolation: isolate;
  }

  .ascii-layer,
  .quiet-zone {
    position: absolute;
    inset: 0;
  }

  .ascii-layer {
    z-index: 0;
  }

  .quiet-zone {
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 44% 34% at 24% 52%,
        rgba(8, 9, 10, 0.95) 0%,
        rgba(8, 9, 10, 0.82) 36%,
        rgba(8, 9, 10, 0.48) 66%,
        rgba(8, 9, 10, 0.10) 88%,
        transparent 100%
      ),
      linear-gradient(
        180deg,
        rgba(8, 9, 10, 0.12) 0%,
        transparent 18%,
        transparent 79%,
        rgba(8, 9, 10, 0.24) 100%
      );
  }

  .hero-shell {
    position: relative;
    z-index: 2;
    width: min(1180px, calc(100% - 48px));
    min-height: calc(100svh - var(--sl-nav-height, 4rem));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 64px;
    padding: 12px 0 96px;
  }

  .copy {
    flex: none;
    width: min(560px, 100%);
  }

  .micro-label {
    margin: 0 0 24px;
    color: rgba(255, 255, 255, 0.68);
    font: 500 11px/1.4 "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.105em;
    text-transform: uppercase;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45);
  }

  h1 {
    margin: 0;
    color: #fbfaf6;
    font-family: "Instrument Serif", "Times New Roman", serif;
    font-weight: 400;
    font-size: clamp(64px, 6.4vw, 92px);
    line-height: 0.91;
    letter-spacing: -0.046em;
    text-shadow:
      0 2px 26px rgba(0, 0, 0, 0.34),
      0 0 1px rgba(255, 255, 255, 0.18);
  }

  h1 span {
    display: block;
  }

  .description {
    max-width: 480px;
    margin: 26px 0 0;
    color: var(--landing-body);
    font: 400 15px/1.7 "Geist", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: -0.012em;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.52);
  }

  .domains {
    max-width: 520px;
    margin: 22px 0 0;
    display: flex;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 12px 22px;
    color: rgba(255, 255, 255, 0.66);
    font: 500 11px/1.4 "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.42);
  }

  .domains span {
    position: relative;
  }

  .domains span:not(:last-child)::after {
    content: "·";
    position: absolute;
    right: -13px;
    color: rgba(255, 255, 255, 0.34);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 12px;
    margin: 32px 0 0;
  }

  .hero-actions a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 0 20px;
    border-radius: 999px;
    font: 500 13px/1 "Geist", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }

  .primary-action {
    background: var(--af-ivory, #F6F4EF);
    color: var(--af-ink, #0C0D10);
  }

  .primary-action:hover {
    background: #E4DFFF;
    color: #111214;
  }

  .secondary-action {
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.9);
  }

  .secondary-action:hover {
    background: rgba(255, 255, 255, 0.10);
    color: #fff;
  }

  @media (max-width: 940px) {
    .hero-shell {
      flex-direction: column;
      align-items: flex-start;
      gap: 44px;
      width: min(100% - 28px, 1180px);
      justify-content: center;
      padding: 8px 0 84px;
    }

    h1 {
      font-size: clamp(52px, 14.5vw, 80px);
    }

    .quiet-zone {
      background:
        radial-gradient(
          ellipse 90% 36% at 50% 55%,
          rgba(8, 9, 10, 0.95) 0%,
          rgba(8, 9, 10, 0.82) 40%,
          rgba(8, 9, 10, 0.36) 74%,
          transparent 100%
        ),
        linear-gradient(
          180deg,
          rgba(8, 9, 10, 0.12) 0%,
          transparent 18%,
          transparent 79%,
          rgba(8, 9, 10, 0.24) 100%
        );
    }
  }
</style>
