---
import { Github } from '@lucide/astro';
---

<div class="agentflow-home-header">
  <div class="inner">
    <a class="brand" href="/" aria-label="Agentflow home">
      <img class="mark" src="/favicon.svg" width="27" height="27" alt="" decoding="async" />
      <span>Agentflow</span>
    </a>

    <nav aria-label="Landing navigation">
      <a class="install-link" href="/start/distribution/">Install</a>
      <a class="explore-link" href="/start/choose-a-skill/">Explore skills</a>
      <a class="github-link" href="https://github.com/howlil/agentflow" target="_blank" rel="noopener noreferrer" aria-label="Agentflow GitHub repository (opens in a new tab)">
        <Github size={15} strokeWidth={1.8} aria-hidden="true" />
        <span class="github-label">GitHub</span>
      </a>
    </nav>
  </div>
</div>

<style>
  .agentflow-home-header {
    --landing-fg: var(--af-ivory, #F6F4EF);
    position: relative;
    left: 50%;
    width: 100vw;
    height: 100%;
    transform: translateX(-50%);
    background: var(--af-ink, #0C0D10);
    color: var(--landing-fg);
  }

  .inner {
    width: min(1180px, calc(100% - 48px));
    height: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.94);
    font: 600 14px/1 "Geist", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .mark {
    width: 27px;
    height: 27px;
    display: block;
    flex: none;
    border-radius: 7px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: rgba(255, 255, 255, 0.68);
    font: 500 12px/1 "Geist", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    text-decoration: none;
    transition: color 160ms ease;
  }

  nav a:hover {
    color: #fff;
  }

  nav a:focus-visible, .brand:focus-visible {
    outline: 2px solid var(--af-accent, #9B8BDE);
    outline-offset: 5px;
    border-radius: 4px;
  }

  :global(body:has(.agentflow-home-header)) {
    --sl-color-bg-nav: var(--af-ink, #0C0D10);
    --sl-color-hairline-light: rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 760px) {
    .inner {
      width: min(100% - 28px, 1180px);
    }

    nav .github-label {
      display: none;
    }

    nav { gap: 13px; }
    nav a { font-size: 11px; }

    nav :global(svg) {
      width: 15px;
      height: 15px;
    }
  }
</style>
